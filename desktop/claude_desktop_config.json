{
  "mcpServers": {
    "r-studio": {
      "command": "uvx",
      "args": ["clauder-mcp"]
    },
    "mlb-stats": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/etweisberg/mlb-mcp",
        "--with", "mcp[cli]<2",
        "python", "-m", "mlb_stats_mcp.server"
      ]
    }
  }
}
